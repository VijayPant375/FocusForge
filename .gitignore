### Dependencies
node_modules/

### Build output
dist/
build/
coverage/

# ─── Secrets & Environment Variables ────────────────────────────────────────
# Block .env at root AND in every subdirectory (e.g. ai-service/.env)
.env
**/.env

# Allow .env.example and .env.production (no real secrets — just templates)
# These are intentionally NOT ignored:
#   .env.example
#   .env.production
# If you ever add real keys to .env.production, add it here too.

# Block any other secret-like env variants just in case
.env.local
**/.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Private Keys & Certificates ────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.der
serviceAccountKey.json
*-service-account*.json

# ─── Logs ───────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

