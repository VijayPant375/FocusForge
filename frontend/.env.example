# Base URL for the API Gateway
# Local development (uses Vite proxy, so leave this unset or use the proxy default)
# VITE_API_URL=http://localhost:5000/api

# Production - set this to your Render api-gateway URL before building
# Example: VITE_API_URL=https://focusforge-api-gateway.onrender.com/api
VITE_API_URL=https://your-api-gateway.onrender.com/api
