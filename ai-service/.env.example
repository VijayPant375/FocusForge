# The port number on which the AI Insights Service listens
PORT=5004

# Connection string to the MongoDB database pointing to the habit data (local or Atlas URI)
MONGODB_URI=mongodb://localhost:27017/habit-tracker-habits

# The secret key used to verify JSON Web Tokens (JWT) for authentication
JWT_SECRET=your-secure-secret-key-goes-here

# Google Gemini API key - get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for insights, coaching, and failure pattern detection
# Defaults to gemini-2.5-flash if not set
GEMINI_MODEL=gemini-2.5-flash
